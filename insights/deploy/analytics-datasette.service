[Unit]
Description=Tandem analytics (Datasette, read-only)
After=network.target

[Service]
Type=simple
User=analytics
Group=analytics
WorkingDirectory=/opt/analytics
ExecStart=/opt/analytics/venv/bin/datasette serve /opt/analytics/data/tandem_analytics.db \
    --host 127.0.0.1 --port 8011 \
    --metadata /opt/analytics/metadata.yml \
    --setting sql_time_limit_ms 3000 \
    --setting allow_download off \
    --setting default_page_size 50 \
    --setting max_returned_rows 10000
Restart=always
RestartSec=3
MemoryMax=200M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/analytics

[Install]
WantedBy=multi-user.target

# Copy to .env and fill in real values. Never commit .env.
#
# Local development (optional — or just run: DEBUG=True python manage.py runserver):
#   DEBUG=True
#   SECRET_KEY=any-local-dev-key
#   ALLOWED_HOSTS=127.0.0.1,localhost
#
# Production (/opt/tandem/.env on the VPS):

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=app.tandemretreat.com
CSRF_TRUSTED_ORIGINS=https://app.tandemretreat.com

# Optional
# TANDEM_UPI_ID=tandem@okicici
# TANDEM_PAYEE_NAME=Tandem
# SMS_ENABLED=False
# SMS_API_KEY=
